{
  "name": "kutarya-oyun",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build:convert": "node scripts/build-convert.mjs && node scripts/package-convert-source.mjs",
    "build:arena": "node scripts/build-block-arena.mjs",
    "build:blackjack": "node --require ./scripts/no-listeners.cjs scripts/build-blackjack.mjs",
    "test:blackjack": "node --require ./scripts/no-listeners.cjs --test blackjack-server/test/*.test.mjs",
    "test:arena": "node scripts/build-block-arena-rules.mjs && node --test arena-server/test/*.test.mjs",
    "build": "tsc -b && vite build",
    "build:seo": "tsc -b && node scripts/build-seo.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5180",
    "test": "node --test tests/*.test.mjs functions/test/*.test.mjs blackjack-server/test/*.test.mjs",
    "emulators": "firebase emulators:start --project demo-kutarya-games --only auth,firestore,functions,storage",
    "seed:local": "node scripts/seed-local.mjs",
    "prepare:video": "node scripts/prepare-video-site.mjs",
    "review:video": "node scripts/review-video-site.mjs",
    "check": "npm test && npm run build",
    "test:integration": "node scripts/integration.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.8.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "firebase": "12.19.0",
    "htmlparser2": "12.0.0",
    "lucide-react": "1.52.0",
    "mammoth": "1.13.0",
    "marked": "18.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "lightningcss": "1.33.0",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
