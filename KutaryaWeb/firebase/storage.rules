rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function admin() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.gamesAdmin == true; }
  match /projectAssets/{uid}/{projectId}/{fileId}/{filename} {
   allow read: if admin();
   allow create: if resource == null && admin() && request.auth.uid == uid
    && request.resource.size > 0 && request.resource.size <= 500 * 1024 * 1024
    && request.resource.contentType == 'application/octet-stream'
    && filename.matches('[a-zA-Z0-9][a-zA-Z0-9._ -]*[.](zip|7z|exe|msi|apk|aab|gz|tgz|pdf)');
   // Kayıtlı sürümün üzerine yazma ve doğrudan silme kapalıdır. Silme API'den yapılır.
   allow update, delete: if false;
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
