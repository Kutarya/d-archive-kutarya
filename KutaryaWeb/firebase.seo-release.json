    "headers": [
      {
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ],
        "regex": ".*"
      },
      {
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ],
        "regex": "^[/\\\\]assets[/\\\\].*"
      },
      {
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ],
        "regex": "^[/\\\\]games[/\\\\].*"
      },
      {
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          }
        ],
        "regex": "^[/\\\\]games[/\\\\].*\\.wasm$"
      },
      {
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          },
          {
            "key": "Content-Encoding",
            "value": "gzip"
          }
        ],
        "regex": "^[/\\\\]games[/\\\\].*\\.wasm\\.gz$"
      },
      {
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          },
          {
            "key": "Content-Encoding",
            "value": "br"
          }
        ],
        "regex": "^[/\\\\]games[/\\\\].*\\.wasm\\.br$"
      },
      {
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          },
          {
            "key": "Content-Encoding",
            "value": "gzip"
          }
        ],
        "regex": "^[/\\\\]games[/\\\\].*\\.js\\.gz$"
      },
      {
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          },
          {
            "key": "Content-Encoding",
            "value": "br"
          }
        ],
        "regex": "^[/\\\\]games[/\\\\].*\\.js\\.br$"
      },
      {
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "Content-Encoding",
            "value": "gzip"
          }
        ],
        "regex": "^[/\\\\]games[/\\\\].*\\.data\\.gz$"
      },
      {
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "Content-Encoding",
            "value": "br"
          }
        ],
        "regex": "^[/\\\\]games[/\\\\].*\\.data\\.br$"
      },
      {
        "regex": "^[/\\\\]ozel(?:[/\\\\].*|\\.html)?$",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/ozel/muvv/0.4.0-20261012/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/ozel/muvv/0.4.0-20261012/Muvv-0.4.0-Proje-20261012.zip",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"Muvv-0.4.0-Proje-20261012.zip\""
          }
        ]
      },
      {
        "regex": "^[/\\\\](admin|auth|hesabim|kutuphanem|oyna|games)([/\\\\].*)?$",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, follow"
          }
        ]
      },
      {
        "regex": "^[/\\\\]app\\.html$",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, follow"
          }
        ]
      },
      {
        "regex": "^[/\\\\](sitemap\\.xml|robots\\.txt)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
