{
  "name": "sube17-pc",
  "version": "0.1.0",
  "private": true,
  "description": "Şube 17 PC oyunu",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "check:publishability": "node scripts/check-publication.cjs",
    "start": "npm run build && electron .",
    "test": "node --test test/electron.test.cjs test/game-engine.test.mjs",
    "pack:portable": "npm run build && node scripts/package-portable.cjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "type": "module"
}
